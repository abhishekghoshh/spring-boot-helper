# CommerceSphere Environment Variables

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=rootroot
MONGO_DATABASE=commercesphere
MONGO_HOST=mongodb
MONGO_PORT=27017

# Redis
REDIS_PASSWORD=rootroot
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=commerce-sphere-jwt-secret-key-that-is-at-least-256-bits-long-for-hs256
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=2592000000

# Identity Service
IDENTITY_SERVICE_PORT=8081

# Catalog Service
CATALOG_SERVICE_PORT=8082

# Cart Service
CART_SERVICE_PORT=8083

# Inventory Service
INVENTORY_SERVICE_PORT=8084

# Order Service
ORDER_SERVICE_PORT=8085

# Service URLs (used for inter-service REST calls)
# Set to localhost for dev outside Docker, service name inside Docker
IDENTITY_SERVICE_URL=http://identity-service:8081
CATALOG_SERVICE_URL=http://catalog-service:8082
CART_SERVICE_URL=http://cart-service:8083
INVENTORY_SERVICE_URL=http://inventory-service:8084
ORDER_SERVICE_URL=http://order-service:8085

# Default admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
